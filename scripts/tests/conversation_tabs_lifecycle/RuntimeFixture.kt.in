package h.Hchat.hooks.items.conversationtabs

import android.content.SharedPreferences
import android.view.Gravity
import android.view.View
import android.view.ViewGroup
import android.widget.HorizontalScrollView
import android.widget.LinearLayout
import android.widget.RelativeLayout
import de.robv.android.xposed.XC_MethodHook
import de.robv.android.xposed.XposedBridge
import h.Hchat.hooks.core.FeatureContext
import h.Hchat.hooks.core.HookRegistry
import h.Hchat.hooks.items.conversationgroup.ConversationGroupHomeProjection
import h.Hchat.preferences.HchatStorage
import h.Hchat.utils.HLog
import h.Hchat.utils.KavaReflector
import java.util.WeakHashMap

// Rendering/config I/O are fixtures; lifecycle and root attachment below are extracted verbatim.
internal object ConversationTabsRuntime {
    // PRODUCTION_CONSTANTS
    private val hosts = WeakHashMap<Any, Host>()
    private var context: FeatureContext? = null
    private var hookedMainUi: Class<*>? = null
    private var listener: SharedPreferences.OnSharedPreferenceChangeListener? = null
    private var filter: Any? = null
    private var loadedIcons: Map<String, Any> = emptyMap()
    private val bitmaps = BitmapCacheFixture()
    var reloads = 0
        private set
    var renders = 0
        private set

    // PRODUCTION_HOST
    // PRODUCTION_METHODS

    private fun clearChangedAccount() = Unit
    private fun reload() {
        if (context == null) return
        reloads++
        hosts.values.forEach(::render)
    }
    private fun render(host: Host) {
        renders++
        host.strip.visibility = if (context == null) View.GONE else View.VISIBLE
    }
    fun hostCount() = hosts.size
    fun root(owner: Any) = hosts[owner]?.root
    fun strip(owner: Any): HorizontalScrollView? = hosts[owner]?.strip
    fun reset() {
        hosts.values.toList().forEach(::removeHost)
        hosts.clear()
        context = null
        hookedMainUi = null
        listener = null
        filter = null
        loadedIcons = emptyMap()
        reloads = 0
        renders = 0
        HookRegistry.get().reset()
        HchatStorage.prefs.registrations = 0
        HLog.errors.clear()
    }
}

internal class BitmapCacheFixture { fun evictAll() = Unit }
internal object ConversationTabsStore { const val PREFS_NAME = "conversation_tabs" }
